# Multi-stage dev build for the Shoplive teleport fork.
# Output: a minimal Debian-slim image carrying Linux teleport / tctl / tsh
# with the Web UI (webassets) bundled in.
#
# The whole local cluster runs in containers — no Go / Node / Rust required on
# the host. BuildKit cache mounts make incremental rebuilds fast.

# syntax=docker/dockerfile:1.6

FROM golang:1.25-bookworm AS builder

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

# Toolchain layered in one step so apt cache is purged in the same layer:
#   build-essential   — CGO compile (sessionhelper etc.)
#   nodejs 24 + pnpm  — Web UI bundling (engines.node ^24)
#   rust 1.94.0       — IronRDP wasm dependency in the Web UI build
#                       (matches rust-toolchain.toml's channel)
#   cargo-binstall    — fetches prebuilt wasm-bindgen-cli (0.2.116) and
#                       wasm-opt (0.116.1) so the upstream Makefile's version
#                       checks short-circuit instead of doing 10+ min cargo
#                       installs from source.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        ca-certificates \
        curl \
        gnupg \
    && install -d -m 0755 /usr/share/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /usr/share/keyrings/nodesource.gpg \
    && chmod 0644 /usr/share/keyrings/nodesource.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && corepack enable \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --no-modify-path --profile minimal --default-toolchain 1.94.0 \
    && rustup target add wasm32-unknown-unknown \
    && curl -L --proto '=https' --tlsv1.2 -sSf \
        https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash \
    && cargo binstall --no-confirm wasm-bindgen-cli@0.2.116 wasm-opt@0.116.1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Pre-pull Go modules so source edits don't reinvoke `go mod download`.
COPY go.mod go.sum ./
COPY api/go.mod api/go.sum ./api/
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Bring in the rest of the source. Heavy paths are filtered by Dockerfile.dockerignore.
COPY . .

# Build pipeline (orchestrated by the upstream Makefile):
#   1. ensure-webassets  →  pnpm install + pnpm build-ui-oss → webassets/teleport
#   2. go build with -tags webassets_embed → binaries embed the Web UI
#
# Trims:
#   RDPCLIENT_SKIP_BUILD=1 — skip building the server-side Rust RDP client.
#   FIDO2=off              — no libfido2/U2F headers; TOTP via Keycloak suffices.
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.local/share/pnpm \
    --mount=type=cache,target=/root/.cache/pnpm \
    make \
        RDPCLIENT_SKIP_BUILD=1 \
        FIDO2=off \
        build/teleport \
        build/tctl \
        build/tsh

FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        bash \
        sudo \
        less \
        vim-tiny \
        iputils-ping \
        net-tools \
    && rm -rf /var/lib/apt/lists/*

# Test users for SSH login experiments. Each gets /bin/bash as login shell and
# a real $HOME so `tsh ssh <user>@<node>` actually opens a usable session.
# `internal.logins` doesn't apply to OIDC users (no logins trait), so the
# admin role uses {{external.preferred_username}} + this explicit list.
RUN useradd -m -s /bin/bash dev \
    && useradd -m -s /bin/bash alice \
    && useradd -m -s /bin/bash jeff \
    && useradd -m -s /bin/bash ubuntu \
    && echo "dev   ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/shoplive-dev \
    && echo "alice ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/shoplive-dev \
    && echo "jeff  ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/shoplive-dev \
    && echo "ubuntu ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/shoplive-dev \
    && chmod 440 /etc/sudoers.d/shoplive-dev

# Trust the Shoplive dev root CA so teleport's OIDC client can verify
# Keycloak's TLS cert during discovery / token exchange. Generated by
# `make pki` before the image is built.
COPY dev/pki/ca/ca.crt /usr/local/share/ca-certificates/shoplive-dev-ca.crt
RUN update-ca-certificates

COPY --from=builder /src/build/teleport /usr/local/bin/teleport
COPY --from=builder /src/build/tctl     /usr/local/bin/tctl
COPY --from=builder /src/build/tsh      /usr/local/bin/tsh

RUN mkdir -p /var/lib/teleport /etc/teleport

EXPOSE 3023 3024 3025 3080 38000

ENTRYPOINT ["teleport"]
CMD ["start", "--config=/etc/teleport/teleport.yaml"]
